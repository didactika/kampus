{
  "name": "@kampus/ui",
  "version": "0.1.0",
  "description": "The design system of Kampus: React components on MUI, themed by Didactika and by the theme of each scope",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens/*": "./tokens/*"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@material-symbols/svg-400": "0.48.3",
    "@mui/material": "9.5.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
