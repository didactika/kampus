  "radius": {
    "$value": "12px",
    "$description": "The medium corner; every other corner is a multiple of it, so 0 makes every shape square"
  },
  "shape": {
    "corner": {
      "none": {
        "$value": "0px"
      },
      "extra-small": {
        "$value": "calc(var(--k-radius) / 3)"
      },
      "small": {
        "$value": "calc(var(--k-radius) * 2 / 3)"
      },
      "medium": {
        "$value": "var(--k-radius)"
      },
      "large": {
        "$value": "calc(var(--k-radius) * 4 / 3)"
      },
      "extra-large": {
        "$value": "calc(var(--k-radius) * 7 / 3)"
      },
      "full": {
        "$value": "calc(var(--k-radius) * 100)"
      }
    }
  },
  "density": {
    "$value": "0",
    "$description": "0 is comfortable; -2 is compact, every control two steps of 4px smaller"
  },
  "size": {
    "control": {
      "$value": "calc(2.5rem + var(--k-density) * 0.25rem)",
      "$description": "Buttons, chips and tabs"
    },
    "field": {
      "$value": "calc(3rem + var(--k-density) * 0.25rem)",
      "$description": "Text fields and selects"
    },
    "touch-target": {
      "$value": "3rem",
      "$description": "The least area a pointer can press"
    },
    "control-small": {
      "$value": "calc(2rem + var(--k-density) * 0.25rem)",
      "$description": "Small buttons: dense toolbars and rows"
    },
    "control-large": {
      "$value": "calc(3.5rem + var(--k-density) * 0.25rem)",
      "$description": "Large buttons: the main action of a page that invites it"
    }
  },
  "space": {
    "1": {
      "$value": "0.25rem"
    },
    "2": {
      "$value": "0.5rem"
    },
    "3": {
      "$value": "0.75rem"
    },
    "4": {
      "$value": "1rem"
    },
    "5": {
      "$value": "1.25rem"
    },
    "6": {
      "$value": "1.5rem"
    },
    "8": {
      "$value": "2rem"
    },
    "10": {
      "$value": "2.5rem"
    },
    "12": {
      "$value": "3rem"
    },
    "16": {
      "$value": "4rem"
    }
  },
  "elevation": {
    "level0": {
      "$value": "none"
    },
    "level1": {
      "$value": "0 1px 2px 0 color-mix(in srgb, var(--k-color-shadow) 30%, transparent), 0 1px 3px 1px color-mix(in srgb, var(--k-color-shadow) 15%, transparent)"
    },
    "level2": {
      "$value": "0 1px 2px 0 color-mix(in srgb, var(--k-color-shadow) 30%, transparent), 0 2px 6px 2px color-mix(in srgb, var(--k-color-shadow) 15%, transparent)"
    },
    "level3": {
      "$value": "0 1px 3px 0 color-mix(in srgb, var(--k-color-shadow) 30%, transparent), 0 4px 8px 3px color-mix(in srgb, var(--k-color-shadow) 15%, transparent)"
    },
    "level4": {
      "$value": "0 2px 3px 0 color-mix(in srgb, var(--k-color-shadow) 30%, transparent), 0 6px 10px 4px color-mix(in srgb, var(--k-color-shadow) 15%, transparent)"
    },
    "level5": {
      "$value": "0 4px 4px 0 color-mix(in srgb, var(--k-color-shadow) 30%, transparent), 0 8px 12px 6px color-mix(in srgb, var(--k-color-shadow) 15%, transparent)"
    }
  },
  "state": {
    "hover": {
      "$value": "0.08"
    },
    "focus": {
      "$value": "0.1"
    },
    "pressed": {
      "$value": "0.1"
    },
    "dragged": {
      "$value": "0.16"
    },
    "disabled-container": {
      "$value": "0.12"
    },
    "disabled-content": {
      "$value": "0.38"
    }
  },
  "motion": {
    "$value": "1",
    "$description": "1 moves; 0, a theme with reduced motion, makes every duration zero"
  },
  "easing": {
    "standard": {
      "$value": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "standard-accelerate": {
      "$value": "cubic-bezier(0.3, 0, 1, 1)"
    },
    "standard-decelerate": {
      "$value": "cubic-bezier(0, 0, 0, 1)"
    },
    "emphasized": {
      "$value": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "emphasized-accelerate": {
      "$value": "cubic-bezier(0.3, 0, 0.8, 0.15)"
    },
    "emphasized-decelerate": {
      "$value": "cubic-bezier(0.05, 0.7, 0.1, 1)"
    },
    "spring-fast-spatial": {
      "$value": "cubic-bezier(0.42, 1.67, 0.21, 0.9)",
      "$description": "Expressive: small moves that overshoot a little, such as a button changing shape"
    },
    "spring-default-spatial": {
      "$value": "cubic-bezier(0.38, 1.21, 0.22, 1)",
      "$description": "Expressive: moves of a surface, such as a card or a sheet"
    },
    "spring-fast-effects": {
      "$value": "cubic-bezier(0.31, 0.94, 0.34, 1)",
      "$description": "Expressive: colour and opacity, no overshoot"
    },
    "spring-default-effects": {
      "$value": "cubic-bezier(0.34, 0.8, 0.34, 1)"
    }
  },
  "duration": {
    "short1": {
      "$value": "calc(50ms * var(--k-motion))"
    },
    "short2": {
      "$value": "calc(100ms * var(--k-motion))"
    },
    "short3": {
      "$value": "calc(150ms * var(--k-motion))"
    },
    "short4": {
      "$value": "calc(200ms * var(--k-motion))"
    },
    "medium1": {
      "$value": "calc(250ms * var(--k-motion))"
    },
    "medium2": {
      "$value": "calc(300ms * var(--k-motion))"
    },
    "medium3": {
      "$value": "calc(350ms * var(--k-motion))"
    },
    "medium4": {
      "$value": "calc(400ms * var(--k-motion))"
    },
    "long1": {
      "$value": "calc(450ms * var(--k-motion))"
    },
    "long2": {
      "$value": "calc(500ms * var(--k-motion))"
    },
    "spring-fast-spatial": {
      "$value": "calc(350ms * var(--k-motion))"
    },
    "spring-default-spatial": {
      "$value": "calc(500ms * var(--k-motion))"
    },
    "spring-fast-effects": {
      "$value": "calc(150ms * var(--k-motion))"
    },
    "spring-default-effects": {
      "$value": "calc(200ms * var(--k-motion))"
    }
  },
  "gradient": {
    "brand": {
      "$value": "linear-gradient(135deg, var(--k-color-brand), color-mix(in srgb, var(--k-color-brand) 55%, var(--k-color-scrim)))",
      "$description": "The gradient of the Kampus icon, from the brand to a deeper brand, the same in both schemes so on-brand text reads on it"
    },
    "progress": {
      "$value": "linear-gradient(90deg, var(--k-color-primary), var(--k-color-accent))",
      "$description": "What advances"
    }
  },
