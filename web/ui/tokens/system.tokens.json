{
  "$description": "The system tokens of the design system, the same in both schemes: typefaces and type scale, corners, density, spacing, elevation, state layers and motion. A theme of a scope sets the typefaces, the root size, the radius, the density and the motion; everything else follows from them.",
  "font": {
    "family": {
      "$type": "fontFamily",
      "plain": {
        "$value": [
          "IBM Plex Sans",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Body, labels and controls"
      },
      "brand": {
        "$value": [
          "Space Grotesk",
          "IBM Plex Sans",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Display, headlines and large titles"
      },
      "mono": {
