# The address people open, without https://; Caddy gets its certificate.
KAMPUS_DOMAIN=campus.example.org
# Generate each secret once and keep it: see the operator guide.
POSTGRES_PASSWORD=
KAMPUS_SECURITY_SECRET_KEY=
# The first administrator, created on the first start only.
KAMPUS_ADMIN_EMAIL=admin@example.org
KAMPUS_ADMIN_USERNAME=admin
KAMPUS_ADMIN_PASSWORD=
# Sending mail (optional): smtp://user:password@host:587 and the sender.
KAMPUS_MAIL_URL=
KAMPUS_MAIL_FROM=
# The handbook the help of each screen opens (optional).
KAMPUS_HELP_URL=
