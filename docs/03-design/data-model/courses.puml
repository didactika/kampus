@startuml
!theme plain
hide empty members
hide circle
skinparam linetype ortho
title Schema courses (PostgreSQL)

entity category {
  * id : uuid <<PK>>
  scope_id : uuid <<FK, UNIQUE>>
  parent_id : uuid <<FK>>
  code : text
  sort_key : text
  visibility : text
}
entity course {
  * id : uuid <<PK>>
  scope_id : uuid <<FK, UNIQUE>>
  category_id : uuid <<FK>>
  short_name : text
  layout_code : text
  language_code : text
  deletion_due_at : timestamptz
  starts_at : timestamptz
  ends_at : timestamptz
  state : text
  visibility : text
}
entity course_layout_setting {
  * course_id : uuid <<PK, FK>>
  * layout_code : text <<PK>>
  values : jsonb
}
entity course_owner {
  * course_id : uuid <<PK, FK>>
  * account_id : uuid <<PK, FK>>
}
entity section {
  * id : uuid <<PK>>
  scope_id : uuid <<FK, UNIQUE>>
  course_id : uuid <<FK>>
  parent_id : uuid <<FK>>
  sort_key : text
  visibility : text
}
entity group {
  * id : uuid <<PK>>
  course_id : uuid <<FK>>
  section_id : uuid <<FK>>
  name : text
  visibility : text
}
entity group_member {
  * group_id : uuid <<PK, FK>>
  * account_id : uuid <<PK, FK>>
  * origin : text <<PK>>
}
entity group_set {
  * id : uuid <<PK>>
  course_id : uuid <<FK>>
}
entity group_set_group {
  * set_id : uuid <<PK, FK>>
  * group_id : uuid <<PK, FK>>
  course_id : uuid <<FK>>
}

category }o--o| category : parent
course }o--|| category
course_layout_setting }o--|| course
course_owner }o--|| course
section }o--|| course
section }o--o| section : parent
group }o--|| course
group }o--o| section
group_member }o--|| group
group_set }o--|| course
group_set_group }o--|| group_set
group_set_group }o--|| group
@enduml
