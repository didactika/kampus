@startuml
!theme plain
hide empty members
hide circle
skinparam linetype ortho
title Schema progress (PostgreSQL)

entity rule {
  id <<PK>>
  course_module_id <<FK>>
  kind
  type_rule_code
  created_at
}
entity signal {
  course_module_id <<FK>>
  account_id <<FK>>
  kind
  at
}
entity type_signal {
  course_module_id <<FK>>
  account_id <<FK>>
  code
  met
  at
}
entity pending {
  course_module_id <<FK>>
  queued_at
}
entity condition_state {
  condition_id <<FK>>
  course_module_id <<FK>>
  required
}
entity activity_state {
  course_module_id <<FK>>
  account_id <<FK>>
  state
  source
  at
  version
}
entity activity_exception {
  course_module_id <<FK>>
  account_id <<FK>>
  state
  reason
  author
  at
}
entity activity_history {
  id <<PK>>
  course_module_id <<FK>>
  account_id <<FK>>
  from_state
  to_state
  cause
  at
}
entity course_setting {
  course_id <<FK>>
  aggregation
  final
}
entity criterion {
  id <<PK>>
  course_id <<FK>>
  kind
  position
}
entity criterion_activity {
  criterion_id <<FK>>
  course_module_id <<FK>>
  required
}
entity criterion_grade {
  criterion_id <<FK>>
  record_id <<FK>>
  min_percent
}
entity criterion_date {
  criterion_id <<FK>>
  on_or_after
}
entity criterion_duration {
  criterion_id <<FK>>
  enrolled_days
}
entity criterion_role_approval {
  criterion_id <<FK>>
  role_id <<FK>>
}
entity criterion_course {
  criterion_id <<FK>>
  required_course_id <<FK>>
}
entity approval {
  criterion_id <<FK>>
  account_id <<FK>>
  approved_by
  at
}
entity prerequisite {
  course_id <<FK>>
  requires_course_id <<FK>>
}
entity course_state {
  course_id <<FK>>
  account_id <<FK>>
  state
  completed_at
  revoked_at
  version
}
entity course_history {
  id <<PK>>
  course_id <<FK>>
  account_id <<FK>>
  event
  cause
  at
}
entity course_pending {
  course_id <<FK>>
  account_id <<FK>>
  queued_at
}

criterion_activity }o--|| criterion
criterion_grade }o--|| criterion
criterion_date }o--|| criterion
criterion_duration }o--|| criterion
criterion_role_approval }o--|| criterion
criterion_course }o--|| criterion
approval }o--|| criterion
@enduml
