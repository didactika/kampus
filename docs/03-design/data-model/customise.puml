@startuml
!theme plain
hide empty members
hide circle
skinparam linetype ortho
title Schema customise (PostgreSQL)

entity term {
  code <<PK>>
  module
  forms
  retired_at
}
entity term_override {
  term_code <<FK>>
  scope_id <<FK>>
  language_code
  singular
  plural
  locked
  version
}
entity field_kind {
  code <<PK>>
  module
  summary
  retired_at
}
entity field {
  id <<PK>>
  kind_code <<FK>>
  scope_id <<FK>>
  code
  name
  type
  required
  visibility
  max_length
  sort_key
  version
}
entity field_choice {
  id <<PK>>
  field_id <<FK>>
  code
  label
  sort_key
}
entity field_value {
  id <<PK>>
  field_id <<FK>>
  text_value
  integer_value
  date_value
  boolean_value
  choice_id <<FK>>
  account_id <<FK>>
  updated_at
}
entity field_value_choice {
  field_value_id <<FK>>
  choice_id <<FK>>
}
entity page_kind {
  code <<PK>>
  module
  summary
  regions
  retired_at
}
entity widget {
  code <<PK>>
  module
  summary
  page_kinds
  settings
  retired_at
}
entity menu_kind {
  code <<PK>>
  module
  summary
  retired_at
}
entity layout {
  id <<PK>>
  page_kind_code <<FK>>
  scope_id <<FK>>
  locked
  version
}
entity placement {
  id <<PK>>
  layout_id <<FK>>
  region
  widget_code <<FK>>
  settings
  permission
  position
}
entity menu {
  id <<PK>>
  menu_kind_code <<FK>>
  scope_id <<FK>>
  locked
  version
}
entity menu_item {
  id <<PK>>
  menu_id <<FK>>
  parent_id <<FK>>
  label
  target
  permission
  position
}
entity theme {
  id <<PK>>
  scope_id <<FK>>
  tokens
  locked
  version
}
entity rule {
  id <<PK>>
  scope_id <<FK>>
  owner_id <<FK>>
  name
  trigger
  conditions
  actions
  enabled
  version
}
entity rule_run {
  id <<PK>>
  rule_id <<FK>>
  event_id <<FK>>
  outcome
  error
  at
}
entity flag {
  code <<PK>>
  module
  summary
  default_value
  retired_at
}
entity flag_value {
  flag_code <<FK>>
  scope_id <<FK>>
  enabled
  locked
}
entity change {
  id <<PK>>
  kind
  object
  scope_id <<FK>>
  actor
  before
  after
  at
}

term_override }o--|| term
field }o--|| field_kind
flag_value }o--|| flag
field_choice }o--|| field
field_value }o--|| field
field_value }o--|| field_choice
field_value_choice }o--|| field_value
field_value_choice }o--|| field_choice
placement }o--|| layout
placement }o--|| widget
layout }o--|| page_kind
menu }o--|| menu_kind
menu_item }o--|| menu
menu_item }o--o| menu_item : parent
rule_run }o--|| rule
@enduml
