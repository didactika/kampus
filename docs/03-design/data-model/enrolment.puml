@startuml
!theme plain
hide empty members
hide circle
skinparam linetype ortho
title Schema enrol (PostgreSQL)

entity instance {
  * id : uuid <<PK>>
  course_id : uuid <<FK>>
  method_code : text
  role_id : uuid <<FK>>
  enabled : boolean
  capacity : integer
  expiry_action : text
}
entity instance_setting {
  * instance_id : uuid <<PK, FK>>
  values : jsonb
}
entity self_key {
  * id : uuid <<PK>>
  instance_id : uuid <<FK>>
  group_id : uuid <<FK>>
  hash : text
}
entity linked_group {
  * instance_id : uuid <<PK, FK>>
  system_group_id : uuid <<FK>>
}
entity linked_course {
  * instance_id : uuid <<PK, FK>>
  source_course_id : uuid <<FK>>
}
entity enrolment {
  * id : uuid <<PK>>
  instance_id : uuid <<FK>>
  account_id : uuid <<FK>>
  status : text
  starts_at : timestamptz
  ends_at : timestamptz
}
entity enrolment_grant {
  * enrolment_id : uuid <<PK, FK>>
  * grant_id : uuid <<PK, FK>>
}
entity request {
  * id : uuid <<PK>>
  instance_id : uuid <<FK>>
  account_id : uuid <<FK>>
  state : text
}
entity expiry_outcome {
  * id : uuid <<PK>>
  enrolment_id : uuid <<FK>>
  action : text
}

instance_setting ||--|| instance
self_key }o--|| instance
linked_group |o--|| instance
linked_course |o--|| instance
enrolment }o--|| instance
enrolment_grant }o--|| enrolment
request }o--|| instance
expiry_outcome }o--|| enrolment
@enduml
