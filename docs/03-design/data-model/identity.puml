@startuml
!theme plain
hide empty members
hide circle
skinparam linetype ortho
title Schemas identity and users (PostgreSQL)

package identity {
  entity account_reference {
    campus_id <<PK, FK>>
    system <<PK>>
    identifier <<PK>>
    record_id <<FK>>
  }
  entity account {
    * id : uuid <<PK, FK access.principal>>
    campus_id : uuid <<FK>>
    scope_id : uuid <<FK, UNIQUE>>
    username : text
    email : text
    status : text
    pseudonym : text
    deletion_due_at : timestamptz
  }
  entity password {
    * account_id : uuid <<PK, FK>>
    hash : text
  }
  entity passkey {
    * id : uuid <<PK>>
    account_id : uuid <<FK>>
    credential : bytea <<UNIQUE>>
  }
  entity identity_provider {
    * id : uuid <<PK>>
    issuer : text
    linking_policy : text
  }
  entity external_identity {
    * id : uuid <<PK>>
    account_id : uuid <<FK>>
    provider_id : uuid <<FK>>
    subject : text
  }
  entity second_factor {
    * id : uuid <<PK>>
    account_id : uuid <<FK>>
    kind : text
  }
  entity session {
    * id : uuid <<PK>>
    account_id : uuid <<FK>>
    token_hash : bytea <<UNIQUE>>
    expires_at : timestamptz
  }
  entity api_token {
    * id : uuid <<PK>>
    account_id : uuid <<FK>>
    prefix : text <<UNIQUE>>
    expires_at : timestamptz
  }
  entity one_time_token {
    * id : uuid <<PK>>
    account_id : uuid <<FK>>
    purpose : text
    hash : bytea <<UNIQUE>>
  }
}
package users {
  entity system_group_reference {
    campus_id <<PK, FK>>
    system <<PK>>
    identifier <<PK>>
    record_id <<FK>>
  }
  entity profile {
    * account_id : uuid <<PK, FK>>
    language_code : text <<FK i18n.language>>
    time_zone : text
  }
  entity account_field {
    * account_id : uuid <<PK, FK>>
    * field_value_id : uuid <<PK, FK customise.field_value>>
  }
  entity system_group {
    * id : uuid <<PK>>
    scope_id : uuid <<FK>>
    code : text
  }
  entity system_group_member {
    * group_id : uuid <<PK, FK>>
    * account_id : uuid <<PK, FK>>
    * origin : text <<PK>>
  }
}

password ||--|| account
passkey }o--|| account
external_identity }o--|| account
external_identity }o--|| identity_provider
second_factor }o--|| account
session }o--|| account
api_token }o--|| account
one_time_token }o--|| account
profile ||--|| account
account_field }o--|| account
system_group_member }o--|| system_group
system_group_member }o--|| account
account_reference }o--|| account
system_group_reference }o--|| system_group
@enduml
