@startuml
!theme plain
hide empty members
hide circle
skinparam linetype ortho
title Schema settings (PostgreSQL)

entity definition {
  key
  module
  kind
  default_value
  levels
  permission
  restart_required
}
entity value {
  id <<PK>>
  definition_key <<FK>>
  scope_id <<FK>>
  value
  locked
  version
}
entity change {
  id <<PK>>
  definition_key <<FK>>
  scope_id
  actor
  before
  after
  at
  request_id
}

value }o--|| definition
change }o--|| definition
@enduml
