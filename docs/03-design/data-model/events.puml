@startuml
!theme plain
hide empty members
hide circle
skinparam linetype ortho
title Schema events (PostgreSQL)

entity event_type {
  code
  version
  module
  schema
  audited
  personal_fields
}
entity event {
  id <<PK>>
  type_code <<FK>>
  type_version
  scope
  actor
  object
  payload
  occurred_at
  request_id
}
entity outbox {
  event_id <<FK>>
  created_at
  dispatched_at
}
entity listener {
  id <<PK>>
  module
  type_code <<FK>>
  handler
  enabled
}
entity delivery {
  listener_id <<FK>>
  event_id <<FK>>
  state
  attempts
  next_attempt_at
  last_error
}
entity audit_entry {
  id <<PK>>
  event_id <<FK>>
  campus_id
  scope
  actor
  object
  summary
  at
}
entity retention_policy {
  campus_id
  kind
  keep_for
}

event }o--|| event_type
outbox }o--|| event
listener }o--|| event_type
delivery }o--|| listener
delivery }o--|| event
audit_entry }o--|| event
@enduml
