@startuml
!theme plain
hide empty members
hide circle
skinparam linetype ortho
title Schema files (PostgreSQL)

entity blob {
  id <<PK>>
  hash <<UNIQUE>>
  size
  media_type
  storage_key
  ref_count
  scan_status
  created_at
}
entity area {
  code <<PK>>
  module
  summary
  max_size
  allowed_types
  upload_permission
  retired_at
}
entity file {
  id <<PK>>
  blob_id <<FK>>
  area_code <<FK>>
  scope_id <<FK>>
  name
  media_type
  size
  uploader
  attached
  created_at
}
entity upload {
  id <<PK>>
  area_code <<FK>>
  scope_id <<FK>>
  uploader
  name
  declared_type
  max_size
  blob_id <<FK>>
  file_id <<FK>>
  expires_at
}
entity trash {
  blob_id <<PK, FK>>
  since
}

file }o--|| blob
file }o--|| area
upload }o--|| area
upload }o--o| blob
upload |o--o| file
trash |o--|| blob
@enduml
