@startuml
!theme plain
hide empty members
hide circle
skinparam linetype ortho
title Schema notify (PostgreSQL)

entity notification_type {
  code
  module
  required
  default_channels
}
entity preference {
  account_id <<FK>>
  type_code <<FK>>
  channel
  enabled
}
entity campus_default {
  campus_id <<FK>>
  type_code <<FK>>
  channel
  enabled
  locked
}
entity template {
  id <<PK>>
  campus_id <<FK>>
  type_code <<FK>>
  channel
  locale
  subject
  body
}
entity notification {
  id <<PK>>
  type_code <<FK>>
  recipient_id <<FK>>
  dedupe
  payload
  in_inbox
  created_at
  read_at
}
entity delivery {
  notification_id <<FK>>
  channel
  state
  attempts
  next_attempt_at
  last_error
  sent_at
}
entity push_subscription {
  id <<PK>>
  account_id <<FK>>
  endpoint
  p256dh
  auth
}
entity conversation {
  id <<PK>>
  kind
  course_group_id <<FK>>
  direct_key
}
entity member {
  conversation_id <<FK>>
  account_id <<FK>>
  joined_at
  left_at
  muted
  last_read_message_id
}
entity message {
  id <<PK>>
  conversation_id <<FK>>
  author_id <<FK>>
  body
  sent_at
}
entity message_deletion {
  message_id <<FK>>
  account_id <<FK>>
  at
}
entity block {
  account_id <<FK>>
  blocked_id <<FK>>
}

preference }o--|| notification_type
campus_default }o--|| notification_type
template }o--|| notification_type
delivery }o--|| notification
member }o--|| conversation
message }o--|| conversation
message_deletion }o--|| message
@enduml
