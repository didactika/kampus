@startuml
!theme plain
skinparam linetype polyline
skinparam responseMessageBelowArrow true

actor "Student" as a
participant "kampus-api" as api
participant "Grade read service" as svc
database "records schema + outbox" as db

a -> api : Opens my grades or the grader report
api -> svc : request
svc -> db : Reads through the visibility service (RN-103), paginated on the server (RN-109)
a -> api : Exports
api -> svc : request
svc -> db : A job builds the file with the same visibility
svc --> a : result
@enduml
