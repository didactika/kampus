@startuml
!theme plain
skinparam linetype polyline
skinparam responseMessageBelowArrow true

actor "Teacher or Manager" as actor
participant "kampus-api" as api
participant "View-as service" as svc
participant "Permission checker" as check
database "access schema + outbox" as db

actor -> api : POST /scopes/{id}/view-as (role)
api -> svc : start
svc -> check : require access.view_as + allowance (RN-018)
svc -> db : view_as_session; access.view_as_started (audit)
loop while browsing
  api -> check : can(context with view-as role)
  check --> api : read permissions of that role only, inside the scope
end
actor -> api : DELETE /scopes/{id}/view-as
svc -> db : end session; access.view_as_ended
@enduml
