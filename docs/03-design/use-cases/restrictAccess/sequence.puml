@startuml
!theme plain
skinparam linetype polyline
skinparam responseMessageBelowArrow true

actor "Teacher" as a
participant "kampus-api" as api
participant "Condition service" as svc
database "activities schema + outbox" as db

a -> api : Builds a tree of conditions
api -> svc : request
svc -> db : Offers only targets the actor may see
a -> api : Saves
api -> svc : request
svc -> db : Validates each condition and its foreign key; replaces the tree with If-Match
svc --> a : result
@enduml
