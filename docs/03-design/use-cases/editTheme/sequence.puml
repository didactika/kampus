@startuml
!theme plain
skinparam linetype polyline
skinparam responseMessageBelowArrow true

actor "Campus administrator" as a
participant "kampus-api" as api
participant "Theme service" as svc
database "customise schema + outbox" as db

a -> api : Changes colours, typography, spacing, radius or motion with a live preview
api -> svc : request
svc -> db : Previews the pages with the tokens
a -> api : Saves
api -> svc : request
svc -> db : Validates the schema and the WCAG 2.2 AA contrast (RN-217); stores the theme
svc --> a : result
@enduml
