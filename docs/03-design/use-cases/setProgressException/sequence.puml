@startuml
!theme plain
skinparam linetype polyline
skinparam responseMessageBelowArrow true

actor "Teacher" as a
participant "kampus-api" as api
participant "Progress exception service" as svc
database "progress schema + outbox" as db

a -> api : Chooses a person, a state and a reason
api -> svc : request
svc -> db : Stores the exception (RN-119)
a -> api : Removes it later
api -> svc : request
svc -> db : The rules apply again
svc --> a : result
@enduml
