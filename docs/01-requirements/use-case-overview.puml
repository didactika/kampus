@startuml
!theme plain
skinparam linetype polyline
left to right direction

actor "Authenticated user" as A_Authenticated_user
actor "Campus administrator" as A_Campus_administrator
actor "Course creator" as A_Course_creator
actor "Integrator" as A_Integrator
actor "Manager" as A_Manager
actor "Plugin developer" as A_Plugin_developer
actor "Student" as A_Student
actor "System" as A_System
actor "Teacher" as A_Teacher
actor "Visitor" as A_Visitor

rectangle "Kampus" {
  package "access" {
    usecase "Grant a role in a scope" as UC_grantRole
    usecase "Override permissions in a scope" as UC_overridePermission
    usecase "Check a permission, with its explanation" as UC_checkPermission
    usecase "Define a role from a template" as UC_defineRole
    usecase "View a scope as another role" as UC_viewAsRole
  }
  package "identity" {
    usecase "Sign up and confirm an account" as UC_signUp
    usecase "Sign in, or recover access" as UC_signIn
    usecase "Set up a second factor" as UC_setUpSecondFactor
    usecase "Manage the lifecycle of accounts" as UC_manageAccountLifecycle
  }
  package "users" {
    usecase "Edit a profile" as UC_editProfile
  }
  package "courses" {
    usecase "Manage course categories" as UC_manageCategories
    usecase "Create and configure a course" as UC_createCourse
    usecase "Organise the sections of a course" as UC_organiseSections
    usecase "Manage groups and group sets" as UC_manageGroups
    usecase "Choose a course layout" as UC_chooseCourseLayout
  }
  package "enrolment" {
    usecase "Enrol people in a course" as UC_enrolPeople
    usecase "Enrol oneself in a course" as UC_selfEnrol
    usecase "Manage an enrolment" as UC_manageEnrolment
    usecase "Link a system group or a course" as UC_linkEnrolmentSource
    usecase "Expire enrolments" as UC_expireEnrolments
  }
  package "activities" {
    usecase "Add an activity or material" as UC_addActivity
    usecase "Restrict access to an activity or section" as UC_restrictAccess
    usecase "Grant an exception" as UC_grantException
    usecase "Copy or move an activity" as UC_copyActivity
    usecase "Delete and restore an activity" as UC_deleteActivity
  }
  package "records" {
    usecase "Receive a grade from an activity" as UC_receiveGrade
    usecase "Configure the academic records of a course" as UC_configureRecords
    usecase "Override or lock a grade" as UC_overrideGrade
    usecase "See grades" as UC_viewGrades
  }
  package "progress" {
    usecase "Track activity progress" as UC_trackActivityProgress
    usecase "Configure course progress" as UC_configureCourseProgress
    usecase "Set a progress exception" as UC_setProgressException
  }
  package "files" {
    usecase "Upload a file" as UC_uploadFile
    usecase "Open or download a file" as UC_downloadFile
  }
  package "events" {
    usecase "Review and retry failed event deliveries" as UC_retryDeliveries
    usecase "Review the audit log" as UC_reviewAuditLog
  }
  package "notify" {
    usecase "Choose how to be notified" as UC_setNotificationPreferences
    usecase "Send a message" as UC_sendMessage
  }
  package "calendar" {
    usecase "See the calendar" as UC_viewCalendar
    usecase "Subscribe to or export a calendar" as UC_subscribeCalendar
  }
  package "settings" {
    usecase "Change a setting" as UC_changeSetting
  }
  package "tasks" {
    usecase "Monitor background tasks" as UC_monitorTasks
  }
  package "privacy" {
    usecase "Export my personal data" as UC_exportMyData
    usecase "Process a deletion request" as UC_processDeletionRequest
  }
  package "i18n" {
    usecase "Choose a language" as UC_chooseLanguage
    usecase "Install language packs and customise messages" as UC_manageLanguagePacks
  }
  package "api" {
    usecase "Register an API client" as UC_registerApiClient
    usecase "Subscribe a webhook" as UC_subscribeWebhook
  }
  package "plugins" {
    usecase "Install a plugin" as UC_installPlugin
    usecase "Upgrade, disable or remove a plugin" as UC_managePlugin
    usecase "Build and package a plugin" as UC_buildPlugin
  }
  package "customise" {
    usecase "Rename terms" as UC_renameTerms
    usecase "Define a custom field" as UC_defineCustomField
    usecase "Arrange a page and its menus" as UC_arrangeLayout
    usecase "Edit the theme" as UC_editTheme
    usecase "Create a rule" as UC_createRule
    usecase "Switch a feature or module on or off" as UC_switchFeature
    usecase "Export and import customisations" as UC_shareCustomisation
  }
}

A_Manager --> UC_grantRole
A_Teacher --> UC_grantRole
A_Manager --> UC_overridePermission
A_Teacher --> UC_overridePermission
A_System --> UC_checkPermission
A_Campus_administrator --> UC_defineRole
A_Teacher --> UC_viewAsRole
A_Manager --> UC_viewAsRole
A_Visitor --> UC_signUp
A_Visitor --> UC_signIn
A_Authenticated_user --> UC_setUpSecondFactor
A_Manager --> UC_manageAccountLifecycle
A_Authenticated_user --> UC_editProfile
A_Manager --> UC_editProfile
A_Manager --> UC_manageCategories
A_Course_creator --> UC_createCourse
A_Manager --> UC_createCourse
A_Teacher --> UC_organiseSections
A_Teacher --> UC_manageGroups
A_Teacher --> UC_chooseCourseLayout
A_Teacher --> UC_enrolPeople
A_Manager --> UC_enrolPeople
A_Authenticated_user --> UC_selfEnrol
A_Teacher --> UC_manageEnrolment
A_Manager --> UC_manageEnrolment
A_Manager --> UC_linkEnrolmentSource
A_System --> UC_expireEnrolments
A_Teacher --> UC_addActivity
A_Teacher --> UC_restrictAccess
A_Teacher --> UC_grantException
A_Teacher --> UC_copyActivity
A_Teacher --> UC_deleteActivity
A_System --> UC_receiveGrade
A_Teacher --> UC_configureRecords
A_Teacher --> UC_overrideGrade
A_Student --> UC_viewGrades
A_Teacher --> UC_viewGrades
A_System --> UC_trackActivityProgress
A_Teacher --> UC_configureCourseProgress
A_Teacher --> UC_setProgressException
A_Authenticated_user --> UC_uploadFile
A_Authenticated_user --> UC_downloadFile
A_Campus_administrator --> UC_retryDeliveries
A_Teacher --> UC_reviewAuditLog
A_Manager --> UC_reviewAuditLog
A_Authenticated_user --> UC_setNotificationPreferences
A_Authenticated_user --> UC_sendMessage
A_Authenticated_user --> UC_viewCalendar
A_Authenticated_user --> UC_subscribeCalendar
A_Campus_administrator --> UC_changeSetting
A_Manager --> UC_changeSetting
A_Teacher --> UC_changeSetting
A_Campus_administrator --> UC_monitorTasks
A_Authenticated_user --> UC_exportMyData
A_Campus_administrator --> UC_processDeletionRequest
A_Authenticated_user --> UC_chooseLanguage
A_Campus_administrator --> UC_manageLanguagePacks
A_Integrator --> UC_registerApiClient
A_Campus_administrator --> UC_registerApiClient
A_Integrator --> UC_subscribeWebhook
A_Campus_administrator --> UC_installPlugin
A_Campus_administrator --> UC_managePlugin
A_Plugin_developer --> UC_buildPlugin
A_Campus_administrator --> UC_renameTerms
A_Manager --> UC_renameTerms
A_Campus_administrator --> UC_defineCustomField
A_Manager --> UC_defineCustomField
A_Campus_administrator --> UC_arrangeLayout
A_Teacher --> UC_arrangeLayout
A_Campus_administrator --> UC_editTheme
A_Campus_administrator --> UC_createRule
A_Teacher --> UC_createRule
A_Campus_administrator --> UC_switchFeature
A_Manager --> UC_switchFeature
A_Campus_administrator --> UC_shareCustomisation

@enduml
