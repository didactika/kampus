@startuml
!theme plain
skinparam linetype polyline
left to right direction

actor "Authenticated user" as A_Authenticated_user

rectangle "Kampus" {
  package "identity" {
    usecase "Set up a second factor" as UC_setUpSecondFactor
  }
  package "users" {
    usecase "Edit a profile" as UC_editProfile
  }
  package "enrolment" {
    usecase "Enrol oneself in a course" as UC_selfEnrol
  }
  package "files" {
    usecase "Upload a file" as UC_uploadFile
    usecase "Open or download a file" as UC_downloadFile
  }
  package "notify" {
    usecase "Choose how to be notified" as UC_setNotificationPreferences
    usecase "Send a message" as UC_sendMessage
  }
  package "calendar" {
    usecase "See the calendar" as UC_viewCalendar
    usecase "Subscribe to or export a calendar" as UC_subscribeCalendar
  }
  package "privacy" {
    usecase "Export my personal data" as UC_exportMyData
  }
  package "i18n" {
    usecase "Choose a language" as UC_chooseLanguage
  }
}

A_Authenticated_user --> UC_setUpSecondFactor
A_Authenticated_user --> UC_editProfile
A_Authenticated_user --> UC_selfEnrol
A_Authenticated_user --> UC_uploadFile
A_Authenticated_user --> UC_downloadFile
A_Authenticated_user --> UC_setNotificationPreferences
A_Authenticated_user --> UC_sendMessage
A_Authenticated_user --> UC_viewCalendar
A_Authenticated_user --> UC_subscribeCalendar
A_Authenticated_user --> UC_exportMyData
A_Authenticated_user --> UC_chooseLanguage

@enduml
