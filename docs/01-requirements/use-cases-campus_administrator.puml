@startuml
!theme plain
skinparam linetype polyline
left to right direction

actor "Campus administrator" as A_Campus_administrator

rectangle "Kampus" {
  package "access" {
    usecase "Define a role from a template" as UC_defineRole
  }
  package "events" {
    usecase "Review and retry failed event deliveries" as UC_retryDeliveries
  }
}

A_Campus_administrator --> UC_defineRole
A_Campus_administrator --> UC_retryDeliveries

@enduml
