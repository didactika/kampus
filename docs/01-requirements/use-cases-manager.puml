@startuml
!theme plain
skinparam linetype polyline
left to right direction

actor "Manager" as A_Manager

rectangle "Kampus" {
  package "access" {
    usecase "Grant a role in a scope" as UC_grantRole
    usecase "Override permissions in a scope" as UC_overridePermission
    usecase "View a scope as another role" as UC_viewAsRole
  }
  package "identity" {
    usecase "Manage the lifecycle of accounts" as UC_manageAccountLifecycle
  }
  package "users" {
    usecase "Edit a profile" as UC_editProfile
  }
  package "courses" {
    usecase "Manage course categories" as UC_manageCategories
    usecase "Create and configure a course" as UC_createCourse
  }
  package "enrolment" {
    usecase "Enrol people in a course" as UC_enrolPeople
    usecase "Manage an enrolment" as UC_manageEnrolment
    usecase "Link a system group or a course" as UC_linkEnrolmentSource
  }
  package "events" {
    usecase "Review the audit log" as UC_reviewAuditLog
  }
}

A_Manager --> UC_grantRole
A_Manager --> UC_overridePermission
A_Manager --> UC_viewAsRole
A_Manager --> UC_manageAccountLifecycle
A_Manager --> UC_editProfile
A_Manager --> UC_manageCategories
A_Manager --> UC_createCourse
A_Manager --> UC_enrolPeople
A_Manager --> UC_manageEnrolment
A_Manager --> UC_linkEnrolmentSource
A_Manager --> UC_reviewAuditLog

@enduml
